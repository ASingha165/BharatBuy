# SIH26108 Environment Variables

# Google Gemini API Key for Explainability Layer (Optional)
GEMINI_API_KEY=

# Gemini per-request HTTP deadline in seconds (Gemini minimum is 10s; default 15s)
GEMINI_REQUEST_TIMEOUT_SECONDS=15.0

# Authentication Secret Key (Required in production)
AUTH_SECRET_KEY=
# Legacy direct authentication toggle (production default: false; requires Firebase Auth)
ENABLE_LEGACY_AUTH=false

# Database & Data Paths
# For PostgreSQL / Neon (production or staging):
# DATABASE_URL=postgresql://neondb_owner:password@ep-xyz.neon.tech/neondb?sslmode=require
# If DATABASE_URL is unset or empty, the system automatically falls back to local SQLite:
DATABASE_URL=
DATABASE_PATH=data/standards-database-v5.db
GRAPH_PATH=data/standards-knowledge-graph-v5.json

# Model Architecture Strategy ("baseline" or "custom")
MODEL_TYPE=baseline

# Path to team's custom trained model artifact (used when MODEL_TYPE=custom)
CUSTOM_MODEL_PATH=models/custom_recommendation_model.pkl

TOP_K=10

# Production & Demo Mode Configuration
# Set to false for production (filters out synthetic demo records)
# Set to true only for offline/jury demo scenarios
BHARATBUY_DEMO_MODE=false

# API Server Config
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","*"]

# Frontend Next.js Public Endpoint
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Firebase Backend Admin Configuration
FIREBASE_PROJECT_ID=bharatbuy-d4b11
# Path to service account credentials JSON (optional; defaults to ADC or project verification)
FIREBASE_CREDENTIALS_PATH=

# Firebase Web App Client Configuration (Optional overrides)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Sourcing Routing & Directions Configuration (Optional; defaults to public OSRM)
NEXT_PUBLIC_ROUTING_API_URL=https://router.project-osrm.org/route/v1/driving
ROUTING_API_KEY=


